# Dependencies - never send to Docker, installed inside the image
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist
build

# Strapi internal cache
.strapi
.strapi-updater.json

# Uploaded media - should come from a volume, not the image
public/uploads/*
!public/uploads/.gitkeep

# Local env files
.env
.env.local
.env.*.local

# Dev tooling
.eslintrc*
.prettierrc*

# Test artefacts
coverage

# Docker files themselves
Dockerfile*
.dockerignore

# Git
.git
.gitignore
.gitattributes

# Editor
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
