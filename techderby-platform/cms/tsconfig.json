{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020"],
    "target": "ES2019",
    "strict": false,
    "ignoreDeprecations": "5.0",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "config/**/*.ts",
    "config/**/*.js",
    "database/**/*.ts",
    "database/**/*.js",
    "types/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    ".cache",
    ".tmp"
  ]
}
