POSTGRES_DB=techderby
POSTGRES_USER=techderby
POSTGRES_PASSWORD=techderby
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=techderby
DATABASE_USERNAME=techderby
DATABASE_PASSWORD=techderby
STRAPI_PORT=1337
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:1337
APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
API_TOKEN_SALT=change-me-api-token-salt
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
TRANSFER_TOKEN_SALT=change-me-transfer-token-salt
