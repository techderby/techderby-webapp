# .env.prod  ─  techderby.org (LIVE production)
# Copy to .env.prod on the VPS and fill in real values. Never commit this file.

POSTGRES_DB=techderby_prod
POSTGRES_USER=techderby
POSTGRES_PASSWORD=CHANGE_ME_strong_password_prod

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=techderby_prod
DATABASE_USERNAME=techderby
DATABASE_PASSWORD=CHANGE_ME_strong_password_prod

APP_KEYS=CHANGE_ME_key1,CHANGE_ME_key2,CHANGE_ME_key3,CHANGE_ME_key4
API_TOKEN_SALT=CHANGE_ME_api_token_salt
ADMIN_JWT_SECRET=CHANGE_ME_admin_jwt_secret
TRANSFER_TOKEN_SALT=CHANGE_ME_transfer_token_salt
JWT_SECRET=CHANGE_ME_jwt_secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Tech Derby <hello@techderby.org>"

PUBLIC_FRONTEND_URL=https://techderby.org
VITE_API_URL=https://cms.techderby.org
